# Optional conference-research exercise. The fixed travel plan and expected
# answer make task success mechanically verifiable while leaving the research
# path to the agent.
CONFERENCE_RESEARCH_MODEL=aws/anthropic/bedrock-claude-sonnet-5
CONFERENCE_RESEARCH_BASE_URL=https://inference-api.nvidia.com
CONFERENCE_RESEARCH_API_MODE=anthropic_messages
CONFERENCE_RESEARCH_LLM_SPAN=anthropic.messages
CONFERENCE_RESEARCH_MAX_TURNS=12
CONFERENCE_RESEARCH_RUN_BUDGET_SECONDS=300
CONFERENCE_RESEARCH_EXPECTED_NAME='COLT 2026'
CONFERENCE_RESEARCH_EXPECTED_SOURCE_PREFIX='https://learningtheory.org/colt2026'
CONFERENCE_RESEARCH_QUERY='Complete every step before answering. Read the travel record in /input/travel-record.md. Search the web for the one conference that satisfies every constraint, then open its official website to confirm the dates and location. Write the conference name, dates, location, and official source URL to /output/conference-verification.md. Do not narrate progress. After the file has been written successfully, reply with only the conference name.'
