# Pinned public smoke contract. Override a value only when intentionally
# evaluating a different supported configuration.
HERMES_MINIMUM_VERSION=0.20.5
NEMO_RELAY_VERSION=0.7.2
SMOKE_MODEL=nvidia/nvidia/nemotron-3.5-lightning
NVIDIA_BASE_URL=https://inference-api.nvidia.com/v1
SMOKE_MAX_TURNS=8
SMOKE_RUN_BUDGET_SECONDS=180
SMOKE_QUERY='Run exactly `python3 sample.py` in the current directory. Reply with only the exact output line.'
SMOKE_EXPECTED_OUTPUT=VALUE=42
