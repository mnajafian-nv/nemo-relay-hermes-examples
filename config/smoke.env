# Pinned tutorial contract. The setup script installs this Hermes source
# release in an isolated runtime and verifies the bundled Relay version.
HERMES_REF=v2026.8.19
HERMES_COMMIT=fcbd1076a93841fa88855acce810e342a5b78101
HERMES_VERSION=0.20.5
NEMO_RELAY_VERSION=0.7.2
SMOKE_MODEL=aws/anthropic/bedrock-claude-sonnet-5
NVIDIA_BASE_URL=https://inference-api.nvidia.com
NVIDIA_API_MODE=anthropic_messages
SMOKE_MAX_TURNS=8
SMOKE_RUN_BUDGET_SECONDS=180
SMOKE_QUERY='Run exactly `python3 /opt/nemo-relay-hermes-tutorial/sample.py`. Reply with only the exact output line.'
SMOKE_EXPECTED_OUTPUT=VALUE=42
SMOKE_REQUIRED_TOOL_COMMAND=/opt/nemo-relay-hermes-tutorial/sample.py
SMOKE_DOCKER_IMAGE=nemo-relay-hermes-tutorial:local
SMOKE_TERMINAL_CWD=/root
